{
  "name": "dsh-node-monitor",
  "version": "0.6.6",
  "type": "module",
  "description": "多 DSH 节点监控与多机集中管控 Hub：状态总览、只读会话、一键/内嵌打开真实 DSH、双向配对、局域网自动发现与令牌配对、插件启停与重启（dry-run + 审计）",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "docs",
    "assets"
  ],
  "scripts": {
    "test": "node --test --test-force-exit test/core.test.js test/host.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/qingshuiliuyun/dsh-node-monitor.git"
  },
  "homepage": "https://github.com/qingshuiliuyun/dsh-node-monitor#readme",
  "bugs": {
    "url": "https://github.com/qingshuiliuyun/dsh-node-monitor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "monitor",
    "multi-node",
    "dashboard",
    "cordis"
  ]
}
